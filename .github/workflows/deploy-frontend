name: Deploy Landing Page

on:
  push:
    branches:
      - main
      - develop

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Obter o Código
        uses: actions/checkout@v4
      
      - name: Definir Ambiente
        id: env
        run: |
          # ⚠️⚠️⚠️ ALTERE O NOME DO PROJETO ⚠️⚠️⚠️
          PROJECT_NAME="lp-inspiratto"
          
          if [ "${{ github.ref_name }}" = "main" ]; then
            echo "CONTAINER_NAME=${PROJECT_NAME}-prod" >> $GITHUB_ENV
            echo "IMAGE_NAME=${PROJECT_NAME}:prod-${{ github.sha }}" >> $GITHUB_ENV
            echo "API_URL=${{ secrets.PROD_REACT_APP_API_URL }}" >> $GITHUB_ENV
            echo "ENVIRONMENT=production" >> $GITHUB_ENV
          else
            echo "CONTAINER_NAME=${PROJECT_NAME}-test" >> $GITHUB_ENV
            echo "IMAGE_NAME=${PROJECT_NAME}:test-${{ github.sha }}" >> $GITHUB_ENV
            echo "API_URL=${{ secrets.TEST_REACT_APP_API_URL }}" >> $GITHUB_ENV
            echo "ENVIRONMENT=testing" >> $GITHUB_ENV
          fi
          
          echo "PROJECT_NAME=${PROJECT_NAME}" >> $GITHUB_ENV
          
          echo "Container: ${CONTAINER_NAME}"
          echo "Image: ${IMAGE_NAME}"
          echo "Environment: ${ENVIRONMENT}"
      
      - name: Verificar Docker
        run: |
          echo "Checking Docker availability..."
          docker --version
          docker info 2>&1 | head -n 10 || true
          echo "Docker is ready!"
      
      - name: Construir Imagem Docker
        run: |
          echo "Building Docker image..."
          
          docker build \
            --build-arg REACT_APP_API_URL="${{ env.API_URL }}" \
            --build-arg NODE_ENV=production \
            -t ${{ env.IMAGE_NAME }} \
            .
          
          echo "Image built successfully!"
          docker images | grep "${{ env.PROJECT_NAME }}"
      
      - name: Parar Container Antigo
        run: |
          echo "Stopping old container..."
          
          if docker ps -a -q -f name=${{ env.CONTAINER_NAME }} | grep -q .; then
            echo "Stopping: ${{ env.CONTAINER_NAME }}"
            docker stop ${{ env.CONTAINER_NAME }} || true
            docker rm ${{ env.CONTAINER_NAME }} || true
            echo "Old container removed"
          else
            echo "No container to stop"
          fi
      
      - name: Limpar Imagens Antigas
        run: |
          echo "Cleaning old images..."
          
          docker images --filter=reference="${{ env.PROJECT_NAME }}" --format "{{.ID}} {{.Tag}}" | \
            grep -v "${{ github.sha }}" | \
            awk '{print $1}' | \
            xargs -r docker rmi -f || echo "No old images to remove"
      
      - name: Iniciar Novo Container
        run: |
          echo "Starting new container..."
          
          docker run -d \
            --name ${{ env.CONTAINER_NAME }} \
            --network npm_network \
            --restart unless-stopped \
            -e NODE_ENV=production \
            -e NEXT_PUBLIC_API_URL="${{ env.API_URL }}" \
            ${{ env.IMAGE_NAME }}
          
          CONTAINER_ID=$(docker ps -aq -f name=${{ env.CONTAINER_NAME }})
          echo "Container ID: $CONTAINER_ID"
          echo ""
          
          if [ -z "$CONTAINER_ID" ]; then
            echo "✗ Failed to create container"
            exit 1
          fi
          
          echo "Waiting for Next.js to initialize..."
          echo "This may take 30-40 seconds..."
          
          # Esperar 40 segundos monitorando o estado
          for i in {1..40}; do
            # Verificar estado do container via inspect (mais confiável)
            RUNNING=$(docker inspect -f '{{.State.Running}}' ${{ env.CONTAINER_NAME }} 2>/dev/null || echo "false")
            
            if [ "$RUNNING" != "true" ]; then
              echo ""
              echo "✗ Container stopped at ${i}s!"
              echo ""
              echo "=== FULL LOGS ==="
              docker logs ${{ env.CONTAINER_NAME }} 2>&1
              echo "================="
              echo ""
              echo "=== CONTAINER STATE ==="
              docker inspect ${{ env.CONTAINER_NAME }} --format '{{json .State}}' | jq . || docker inspect ${{ env.CONTAINER_NAME }} --format '{{json .State}}'
              echo "======================="
              exit 1
            fi
            
            echo -n "."
            sleep 1
          done
          echo ""
          echo ""
          
          # Verificação final usando inspect
          FINAL_STATE=$(docker inspect -f '{{.State.Running}}' ${{ env.CONTAINER_NAME }})
          
          if [ "$FINAL_STATE" = "true" ]; then
            echo "✓ Container is running successfully!"
            echo ""
            
            echo "=== Container Details ==="
            docker inspect ${{ env.CONTAINER_NAME }} --format 'Name: {{.Name}}'
            docker inspect ${{ env.CONTAINER_NAME }} --format 'Status: {{.State.Status}}'
            docker inspect ${{ env.CONTAINER_NAME }} --format 'Running: {{.State.Running}}'
            docker inspect ${{ env.CONTAINER_NAME }} --format 'Started: {{.State.StartedAt}}'
            echo "========================="
            echo ""
            
            echo "=== Last 20 lines of logs ==="
            docker logs ${{ env.CONTAINER_NAME }} --tail 20
            echo "=============================="
            echo ""
            
            echo "Testing Next.js server..."
            
            # Esperar mais 5 segundos para o servidor estar 100% pronto
            sleep 5
            
            # Tentar acessar
            if docker exec ${{ env.CONTAINER_NAME }} wget --spider -q http://localhost:3000 2>/dev/null; then
              echo "✓ Next.js is responding on port 3000"
            else
              echo "⚠ Next.js may still be initializing (this is usually OK)"
            fi
            
            echo ""
            echo "Container running successfully!"
            docker ps --filter name=${{ env.CONTAINER_NAME }} --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
            
          else
            echo "✗ Container is not running"
            echo ""
            echo "=== FULL LOGS ==="
            docker logs ${{ env.CONTAINER_NAME }} 2>&1
            echo "================="
            exit 1
          fi

      
      - name: Verificar Deploy
        run: |
          echo "Verifying deployment..."
          
          CONTAINER_ID=$(docker ps -q -f name=${{ env.CONTAINER_NAME }})
          
          if [ -z "$CONTAINER_ID" ]; then
            echo "✗ Container is not running!"
            docker logs ${{ env.CONTAINER_NAME }}
            exit 1
          fi
          
          echo "✓ Container is healthy"
          echo "   ID: $CONTAINER_ID"
          
          NETWORK=$(docker inspect ${{ env.CONTAINER_NAME }} --format '{{range $net,$v := .NetworkSettings.Networks}}{{$net}}{{end}}')
          echo "   Network: $NETWORK"
          
          if [ "$NETWORK" = "npm_network" ]; then
            echo "   Connected to npm_network"
          else
            echo "   WARNING: Not in npm_network!"
          fi
      
      - name: Resumo do Deploy
        if: always()
        run: |
          echo ""
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo "                DEPLOY SUMMARY              "
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo "Branch:        ${{ github.ref_name }}"
          echo "Commit:        ${{ github.sha }}"
          echo "Author:        ${{ github.actor }}"
          echo "Environment:   ${{ env.ENVIRONMENT }}"
          echo "Container:     ${{ env.CONTAINER_NAME }}"
          echo "Image:         ${{ env.IMAGE_NAME }}"
          echo "Time:          $(date +'%Y-%m-%d %H:%M:%S')"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          
          if docker ps | grep -q ${{ env.CONTAINER_NAME }}; then
            echo "Status:        ✓ SUCCESS"
          else
            echo "Status:        ✗ FAILED"
          fi
